# Database: PostgreSQL (production-ready, scalable).
# Local dev: postgresql://postgres@localhost:5545/nimbuscrm?schema=public (requires local Postgres)
# Railway: set via Railway's Postgres plugin dashboard, e.g. postgresql://user:pass@host:5432/db?schema=public
DATABASE_URL="postgresql://postgres@localhost:5432/nimbuscrm?schema=public"

# Generate a strong value with: openssl rand -base64 32
NEXTAUTH_SECRET="dev-secret-change-me-in-production-please-9f8a7b6c5d4e3f2a"
NEXTAUTH_URL="http://localhost:3000"
