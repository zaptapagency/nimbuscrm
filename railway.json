{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE"
  },
  "deploy": {
    "restartPolicyMaxRetries": 5,
    "restartPolicyWindow": 600,
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 60,
    "healthcheckIntervalMs": 5000,
    "numReplicas": 1
  }
}
